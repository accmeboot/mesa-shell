#!/usr/bin/env bash
set -euo pipefail

repo=$(dirname "$(readlink -f "$0")")
config=$repo/config.json
state=${XDG_STATE_HOME:-$HOME/.local/state}/mshell
configs=${XDG_CONFIG_HOME:-$HOME/.config}
polarities=(dark light)
declare -A cfg=()
tmp=

usage() {
  cat >&2 <<EOF
usage: mshell run [qs args...]             start the shell
       mshell build                       generate both palettes, render templates
                                          and write the colors into config.json
       mshell status                      show the built palettes
       mshell wall <dark|light> [image]   set a polarity's wallpaper and build
                                          (no image: pick one with yazi)
       mshell apply [dark|light]          point GTK3, Qt and the icon theme at a
                                          polarity (default: the current one)
       mshell dmenu                       pick one of stdin's lines in the bar
                                          launcher and print it
       mshell <target> <function> [args]  call the running shell over IPC
                                          (mshell ipc show lists them)
EOF
  exit 2
}

die() {
  echo "mshell: $*" >&2
  exit 1
}

check_polarity() {
  [[ $1 == dark || $1 == light ]] || usage
}

load_config() {
  [[ -r $config ]] || die "missing $config (run install.sh)"
  local assignments
  assignments=$(jq -r '
    def otherwise($default): if . == null or . == "" then $default else . end;
    def var($path; $default):
      "cfg[\($path)]=\(getpath($path | split(".")) | otherwise($default) | tostring | @sh)";
    var("scheme.dark"; "default-dark"),
    var("scheme.light"; "default-light"),
    var("wallpaper.dark"; ""),
    var("wallpaper.light"; ""),
    var("wallpaper.dir"; "~/Pictures"),
    var("iconTheme.dark"; "Papirus-Dark"),
    var("iconTheme.light"; "Papirus-Light"),
    var("retint.rotate"; 15),
    var("retint.tint"; 0.15),
    var("retint.maxRampChroma"; 0.030),
    var("font.name"; "sans-serif"),
    var("font.serif"; "serif"),
    var("font.mono"; "monospace"),
    var("font.size"; 14),
    var("font.applicationsSize"; 12),
    var("font.terminalSize"; 16)
  ' "$config") || die "can't read $config"
  eval "$assignments"
}

resolve() {
  case $1 in
    "") ;;
    file://*) printf '%s' "${1#file://}" ;;
    "~/"*) printf '%s' "$HOME/${1#"~/"}" ;;
    /*) printf '%s' "$1" ;;
    *) printf '%s' "$repo/$1" ;;
  esac
}

scheme_path() {
  if [[ $1 == */* ]]; then
    resolve "$1"
  else
    printf '%s' "$repo/theme/schemes/$1.yaml"
  fi
}

generate() {
  local polarity=$1 scheme=$2 wallpaper=$3
  [[ -r $scheme ]] || die "$polarity: scheme not found: $scheme"

  if [[ -z $wallpaper ]]; then
    cat "$scheme"
    return
  fi
  [[ -r $wallpaper ]] || die "$polarity: wallpaper not found: $wallpaper"
  "$repo/theme/retint.py" \
    --scheme "$scheme" \
    --image "$wallpaper" \
    --rotate "${cfg[retint.rotate]}" \
    --tint "${cfg[retint.tint]}" \
    --max-ramp-chroma "${cfg[retint.maxRampChroma]}"
}

palette_variables() {
  awk -v slug="$2" '
    function hex2dec(h,    i, n) {
      n = 0
      for (i = 1; i <= length(h); i++)
        n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
      return n
    }
    function out(key, val) { printf "%s\t%s\n", key, val }
    function color(key, hex,    r, g, b) {
      r = substr(hex, 1, 2); g = substr(hex, 3, 2); b = substr(hex, 5, 2)
      out(key "-hex", hex)
      out(key "-hex-bgr", b g r)
      out(key "-hex-r", r); out(key "-hex-g", g); out(key "-hex-b", b)
      out(key "-rgb-r", hex2dec(r)); out(key "-rgb-g", hex2dec(g)); out(key "-rgb-b", hex2dec(b))
      out(key "-dec-r", sprintf("%.8f", hex2dec(r) / 255))
      out(key "-dec-g", sprintf("%.8f", hex2dec(g) / 255))
      out(key "-dec-b", sprintf("%.8f", hex2dec(b) / 255))
    }

    BEGIN { out("scheme-slug", slug) }

    /^[[:space:]]*[A-Za-z0-9]+:/ {
      key = $0; sub(/^[[:space:]]*/, "", key); sub(/:.*/, "", key)
      val = $0; sub(/^[^:]*:[[:space:]]*/, "", val)
      sub(/[[:space:]]+$/, "", val); gsub(/^["\047]|["\047]$/, "", val)

      if (key ~ /^(base0[0-9A-F]|highlight)$/) {
        hex = tolower(val); sub(/^#/, "", hex)
        seen[key] = hex
        color(key, hex)
      } else if (key ~ /^(system|name|author|variant)$/) {
        out("scheme-" key, val)
      }
    }

    END { if (!("highlight" in seen)) color("highlight", seen["base0D"]) }
  ' "$1"
}

config_variables() {
  printf '%s\t%s\n' \
    output-dir "$state/$1" \
    wallpaper "$2" \
    icon-theme "${cfg[iconTheme.$1]}" \
    font-sans "${cfg[font.name]}" \
    font-serif "${cfg[font.serif]}" \
    font-mono "${cfg[font.mono]}" \
    font-size-applications "${cfg[font.applicationsSize]}" \
    font-size-desktop "${cfg[font.size]}" \
    font-size-terminal "${cfg[font.terminalSize]}"
}

shell_colors() {
  jq -Rn '
    [inputs | split("\t") | {(.[0]): .[1]}] | add
    | with_entries(.value = "#" + .value)
    | {
        background: .["base00-hex"],
        surface: .["base01-hex"],
        on_surface: .["base02-hex"],
        foreground: .["base05-hex"],
        highlight: .["highlight-hex"],
        attention: .["base0A-hex"],
        ok: .["base0B-hex"],
        critical: .["base08-hex"]
      }
  ' <"$1"
}

render() {
  awk -v template="$2" '
    NR == FNR {
      i = index($0, "\t")
      vars[substr($0, 1, i - 1)] = substr($0, i + 1)
      next
    }
    {
      line = $0; rendered = ""
      while ((s = index(line, "{{")) > 0) {
        rest = substr(line, s + 2)
        e = index(rest, "}}")
        if (e == 0) break
        key = substr(rest, 1, e - 1)
        if (!(key in vars)) {
          printf "mshell: %s:%d: unknown variable {{%s}}\n", template, FNR, key > "/dev/stderr"
          exit 1
        }
        rendered = rendered substr(line, 1, s - 1) vars[key]
        line = substr(rest, e + 2)
      }
      print rendered line
    }
  ' "$1" "$2"
}

render_templates() {
  local variables=$1 out=$2 template
  while IFS= read -r -d '' template; do
    template=${template#./}
    mkdir -p "$(dirname "$out/$template")"
    render "$variables" "$repo/theme/templates/$template" >"$out/$template"
  done < <(cd "$repo/theme/templates" && find . -type f ! -name .gitkeep -print0)
}

build_polarity() {
  local polarity=$1 out=$tmp/$1 variables=$tmp/$1.variables scheme wallpaper
  scheme=$(scheme_path "${cfg[scheme.$polarity]}")
  wallpaper=$(resolve "${cfg[wallpaper.$polarity]}")

  mkdir "$out"
  generate "$polarity" "$scheme" "$wallpaper" >"$out/scheme.yaml"
  {
    palette_variables "$out/scheme.yaml" "$(basename "$scheme" .yaml)"
    config_variables "$polarity" "$wallpaper"
  } >"$variables"
  shell_colors "$variables" >"$tmp/$polarity.colors.json"
  render_templates "$variables" "$out"
}

write_config() {
  local filter='.colors.dark = $dark | .colors.light = $light' args=()
  if (($#)); then
    filter+=" | $1"
    args=("${@:2}")
  fi
  jq --argjson dark "$(<"$tmp/dark.colors.json")" \
    --argjson light "$(<"$tmp/light.colors.json")" \
    "${args[@]}" "$filter" "$config" >"$tmp/config.json"
  cat "$tmp/config.json" >"$config"
}

sync_state() {
  local dir=$state/$1 file
  mkdir -p "$dir"
  cp -R "$tmp/$1/." "$dir/"
  while IFS= read -r -d '' file; do
    [[ -e $tmp/$1/$file ]] || rm "$dir/$file"
  done < <(cd "$dir" && find . -type f -print0)
  find "$dir" -mindepth 1 -type d -empty -delete
}

reload_apps() {
  if gsettings writable org.gnome.desktop.interface font-name &>/dev/null; then
    gsettings set org.gnome.desktop.interface font-name "${cfg[font.name]} ${cfg[font.applicationsSize]}"
    gsettings set org.gnome.desktop.interface monospace-font-name "${cfg[font.mono]} ${cfg[font.applicationsSize]}"
  fi
  apply
  reload_gtk
  pkill -USR2 -x ghostty || true
  pkill -USR1 -x nvim || true
}

# Running apps only re-read their CSS when a setting changes: GTK3 on gtk-theme,
# GTK4 on prefers-color-scheme/contrast. Flip them and back without a visible change.
reload_gtk() {
  local interface=org.gnome.desktop.interface a11y=org.gnome.desktop.a11y.interface theme contrast
  gsettings writable "$interface" gtk-theme &>/dev/null || return 0
  theme=$(gsettings get "$interface" gtk-theme)
  gsettings set "$interface" gtk-theme "''"
  gsettings set "$interface" gtk-theme "$theme"
  gsettings writable "$a11y" high-contrast &>/dev/null || return 0
  contrast=$(gsettings get "$a11y" high-contrast)
  gsettings set "$a11y" high-contrast "$([[ $contrast == true ]] && echo false || echo true)"
  gsettings set "$a11y" high-contrast "$contrast"
}

build() {
  mkdir -p "$state"
  tmp=$(mktemp -d "$state/.build.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT

  local polarity
  for polarity in "${polarities[@]}"; do build_polarity "$polarity"; done
  write_config "$@"
  for polarity in "${polarities[@]}"; do sync_state "$polarity"; done
  reload_apps
}

apply() {
  local polarity=${1-} icons= qtct gsettings=
  gsettings writable org.gnome.desktop.interface gtk-theme &>/dev/null && gsettings=1
  if [[ -z $polarity ]]; then
    polarity=light
    [[ -n $gsettings && $(gsettings get org.gnome.desktop.interface color-scheme) == *prefer-dark* ]] && polarity=dark
  fi
  check_polarity "$polarity"

  if [[ -n $gsettings ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme "base16-$polarity"
    { read -r icons <"$state/$polarity/icon-theme"; } 2>/dev/null || true
    [[ -n $icons ]] && gsettings set org.gnome.desktop.interface icon-theme "$icons"
  fi
  for qtct in qt5ct qt6ct; do
    mkdir -p "$configs/$qtct"
    ln -sfn "$state/$polarity/qtct.conf" "$configs/$qtct/$qtct.conf"
  done
  ln -sfn "$polarity" "$state/current"
  if [[ -n ${SWAYSOCK-} ]] && command -v swaymsg >/dev/null; then
    swaymsg -q -- "$(paste -sd ';' "$state/current/sway")" || true
  fi
}

status() {
  local polarity scheme name swatches key val
  echo "config: $config"
  echo "state:  $state"
  for polarity in "${polarities[@]}"; do
    scheme="$state/$polarity/scheme.yaml"
    if [[ ! -r $scheme ]]; then
      printf '%-6s not built\n' "$polarity"
      continue
    fi
    name="" swatches=""
    while IFS=$'\t' read -r key val; do
      case $key in
        scheme-name) name=$val ;;
        base0?-hex)
          swatches+=$'\e[48;2;'"$((16#${val:0:2}));$((16#${val:2:2}));$((16#${val:4:2}))m  "$'\e[0m'
          ;;
      esac
    done < <(palette_variables "$scheme" "")
    printf '%-6s %s %s\n' "$polarity" "$swatches" "$name"
  done
}

dmenu() {
  local sock="${XDG_RUNTIME_DIR:?}/mesa-shell-dmenu.sock"
  [[ -S $sock ]] || die "shell not running: no $sock"
  { cat; printf '\0'; } | socat -t 86400 - "UNIX-CONNECT:$sock,shut-none"
}

wall() {
  local polarity=${1-} image=${2-} choice
  check_polarity "$polarity"
  load_config

  if [[ -z $image ]]; then
    command -v yazi >/dev/null || die "yazi not found"
    mkdir -p "$state"
    choice=$(mktemp "$state/.choice.XXXXXX")
    trap "rm -f ${choice@Q}" EXIT
    yazi --chooser-file="$choice" "$(resolve "${cfg[wallpaper.dir]}")"
    image=$(head -n 1 "$choice")
    rm -f "$choice"
    trap - EXIT
    [[ -n $image ]] || exit 0
  fi
  [[ -f $image && -r $image ]] || die "not a readable file: $image"

  image=$(readlink -f "$image")
  cfg[wallpaper.$polarity]=$image
  build ".wallpaper.$polarity = \$image" --arg image "$image"
}

shell() {
  exec qs -c mesa-shell "$@"
}

case ${1-} in
  run) shift; shell "$@" ;;
  build) load_config; build ;;
  status) status ;;
  wall) shift; wall "$@" ;;
  apply) shift; apply "$@" ;;
  dmenu)
    if (($# == 1)); then dmenu; else shell ipc call "$@"; fi
    ;;
  ipc) shift; shell ipc "$@" ;;
  "" | -h | --help) usage ;;
  *) shell ipc call "$@" ;;
esac
